# TrustLayer works without an .env file. These settings are optional overrides.
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Local data defaults to ./.trustlayer/trustlayer.db
TRUSTLAYER_DATA_DIR=

# auto: use AIG when reachable, otherwise run context-only assessments
# enabled: require AIG at startup
# disabled: never attempt technical scans
LOCAL_SCANNER_MODE=auto
AIG_BASE_URL=http://127.0.0.1:8088

# Prevent npm start from opening the default browser.
TRUSTLAYER_NO_OPEN=0
